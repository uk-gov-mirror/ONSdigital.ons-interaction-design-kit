<style>
  .topics {
    display: grid;
    gap: var(--layout-gutter);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--spacing-lg) 0;
  }

  @media screen and (max-width: 800px) {
    .topics {
      display: flex;
      flex-direction: column;
    }
  }
</style>
