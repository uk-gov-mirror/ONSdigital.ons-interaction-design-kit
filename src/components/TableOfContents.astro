---
interface Section {
  id: string;
  title: string;
}

interface Props {
  sections?: Section[];
}

const { sections = [] } = Astro.props;
---

<nav class="table-of-contents">
  <h2>Contents</h2>

  <ul>
    { sections.map((section) => (
      <li>
        <a href={`#${section.id}`}>{ section.title }</a>
      </li>
    ))}
  </ul>

</nav>

<style>
  .table-of-contents {
    position: sticky;
    top: var(--spacing-md);
  }

  ul {
    list-style: none;
    padding: 16px 0;
    margin: 0;
  }

  ul li {
    margin: 0 0 var(--spacing-2xs) 0;
  }

  li::before {
    content: "—";
    margin-right: 8px;
  }
</style>