---
import Heading from "../components/Heading.astro";

const { type, caption, title, description, metadata } = Astro.props;
---

<section class={`banner ${type}-banner`}>
  <div class="container">
    <Heading
      caption={ caption }
      title={ title }
      size="page"
    />
    <p>{ description }</p>
    <p>{ metadata }</p>
  </div>
</section>

<style>
  .banner {
    padding: var(--spacing-lg) var(--layout-desktop-outside-margin);
  }

  .banner .container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .topic-banner {
    background-color: var(--color-tint-ocean-blue);    
  }

  .page-banner {
    background-color: var(--color-greyscale-grey-5);
  }

  @media screen and (max-width: 46.5rem) {
    .banner {
      padding: var(--spacing-lg) var(--layout-tablet-outside-margin);
    }
  }

  @media screen and (max-width: 30rem) {
    .banner {
       padding: var(--spacing-lg) var(--layout-mobile-outside-margin);
    }
  }
</style>