---
import Heading from "../components/Heading.astro";

const { caption, title, description, metadata = {} } = Astro.props;

const formatMetadataLabel = (key: string) =>
  key.replace(/([A-Z])/g, " $1").replace(/^./, (character) => character.toUpperCase());
---

<section class="banner">
  <div class="container">
    <Heading
      caption={ caption }
      title={ title }
      size="page"
    />
    <p class="description">{ description }</p>

    { Object.keys(metadata).length > 0 && (
      <dl class="metadata-list">
        { Object.entries(metadata).map(([key, value]) => (
          <>
            <dt>{ formatMetadataLabel(key) }</dt>
            <dd>{ value }</dd>
          </>
        )) }
      </dl>
    ) }
  </div>
</section>

<style>
  .banner {
    padding: var(--spacing-lg) 0;
    background-color: var(--color-greyscale-grey-5);
  }

  .banner .container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .description {
    max-width: var(--layout-content-width);
  }
</style>