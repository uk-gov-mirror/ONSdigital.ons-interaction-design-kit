---
import type { MarkdownHeading } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import TableOfContents from "../components/TableOfContents.astro";
import HeadlineFactsAndFigures from "../components/HeadlineFactsAndFigures.astro";

const { caption, title, description, metadata, sections = [] } = Astro.props;

const toc = sections.filter((h: MarkdownHeading) => h.depth === 2);
---

<BaseLayout>
  <PageBanner
    type="page"
    caption={ caption }
    title={ title }
    description={ description }
    metadata={ metadata }>
  </PageBanner>

  <main>
    <div class="container">

      <HeadlineFactsAndFigures />

      <div class="layout">

        <aside class="table-of-contents">
          <TableOfContents sections={ toc } />
        </aside>

        <div class="page-content">
          <slot />
        </div>

      </div>
    </div>
  </main>

</BaseLayout>

<style>
  main {
    margin: 64px var(--layout-desktop-outside-margin) 80px;
  }

  .layout {
    display: grid;
    gap: var(--layout-gutter);
    grid-template-columns: 1fr 2fr;
  }

  @media screen and (max-width: 46.5rem) {
    main {
      margin: 64px var(--layout-tablet-outside-margin) 80px;
    }
  }

  @media screen and (max-width: 30rem) {
    main {
       margin: 64px var(--layout-mobile-outside-margin) 80px;
    }
  }
</style>