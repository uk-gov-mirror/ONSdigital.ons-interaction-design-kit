---
import type { MarkdownHeading } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBanner from "../components/PageBanner.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Metadata {
  releaseDate?: string;
  nextRelease?: string;
  contactName?: string;
  contactEmail?: string;
}

interface Content {
  caption?: string;
  title: string;
  description: string;
  metadata?: Metadata;
}

interface Props {
  content: Content;
  headings?: MarkdownHeading[];
  showTableOfContents?: boolean;
}

const {
  content,
  headings = [],
  showTableOfContents = true,
} = Astro.props;

const {
  caption,
  title,
  description,
  metadata,
} = content;

const sections: MarkdownHeading[] = headings;

const toc = sections
  .filter((section) => section.depth === 2)
  .map((section) => ({
    id: section.slug,
    title: section.text,
  }));
---

<BaseLayout>
  <PageBanner
    type="page"
    caption={ caption }
    title={ title }
    description={ description }
    metadata={ metadata }>
  </PageBanner>

  <main>
    <div class="container">

      <div class:list={["layout", { "layout--with-toc": showTableOfContents }]}>

        { showTableOfContents && (
          <aside class="table-of-contents">
            <TableOfContents sections={ toc } />
          </aside>
        )}

        <div class="page-content">
          <slot />
        </div>

      </div>
    </div>
  </main>

</BaseLayout>

<style>
  main {
    margin: 64px 0 80px 0;
  }

  .layout {
    display: grid;
    gap: var(--layout-gutter);
    grid-template-columns: 1fr 2fr;
  }
</style>